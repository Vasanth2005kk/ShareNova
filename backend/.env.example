# ─── Server ──────────────────────────────────────────────
APPNAME=ShareNova
HOST=0.0.0.0
PORT=8000
# "production" disables the debug server/reloader
APP_ENV=development
LOG_LEVEL=INFO

# ─── Database (relative paths are relative to backend/) ──
DATABASE_URL=sqlite:///storage/sharenova.db

# ─── Local file storage (relative to backend/) ──────────
STORAGE_DIR=storage

# ─── Security ────────────────────────────────────────────
BCRYPT_ROUNDS=12
SESSION_TOKEN_TTL_SECONDS=900

# ─── Limits ──────────────────────────────────────────────
MAX_UPLOAD_BYTES=524288000
MAX_FILES_PER_SHARE=20

# ─── Cleanup of expired shares ───────────────────────────
CLEANUP_INTERVAL_SECONDS=300

# ─── Rate limits (Flask-Limiter syntax) ──────────────────
RATELIMIT_ENABLED=true
RATE_LIMIT_RETRIEVAL=200/minute
RATE_LIMIT_PASSWORD=50/10minutes
RATE_LIMIT_UPLOAD=10/hour
RATE_LIMIT_UPDATE=120/minute

# ─── CORS (comma-separated origins) ──────────────────────
FRONTEND_URL=http://localhost:5173
# Set to 1 when running behind a single reverse proxy (nginx etc.)
TRUST_PROXY_HOPS=0
